DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ivan
DB_NAME=mac_documents
PORT=3000

STORAGE_PATH=./storage/pdf
TEMPLATE_STORAGE_PATH=./storage/templates
UPLOAD_PATH=./storage/uploads
MAX_FILE_SIZE_MB=10
MAX_TEMPLATE_CONTENT_BYTES=200000

# --- Pandoc ---
PANDOC_PATH=C:\Users\ivand\AppData\Local\Microsoft\WinGet\Packages\JohnMacFarlane.Pandoc_Microsoft.Winget.Source_8wekyb3d8bbwe\pandoc-3.9.0.2\pandoc.exe

# Motore PDF — scegli UNO:
# Typst (consigliato): veloce ~0.3s, installa da https://github.com/typst/typst/releases
PANDOC_PDF_ENGINE=typst
# LaTeX (fallback): ~7s, richiede MiKTeX o TeX Live
# PANDOC_PDF_ENGINE=C:\Users\ivand\AppData\Local\Programs\MiKTeX\miktex\bin\x64\pdflatex.exe

# --- Limiti generazione ---
PDF_GENERATION_TIMEOUT_MS=30000
PDF_GENERATION_RETRIES=2
PDF_GENERATION_RETRY_DELAY_MS=500
MAX_PDF_MARKDOWN_BYTES=300000
