NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ivan
DB_NAME=mac_documents

# Storage locale
STORAGE_PATH=./storage/pdf
UPLOAD_PATH=./storage/uploads

# Pandoc — percorso Windows (MiKTeX)
PANDOC_PATH=C:\Users\ivand\AppData\Local\Microsoft\WinGet\Packages\JohnMacFarlane.Pandoc_Microsoft.Winget.Source_8wekyb3d8bbwe\pandoc-3.9.0.2\pandoc.exe

# XeLaTeX — motore hardcodato nel service, questa var non viene letta
# Lasciata solo come riferimento al percorso locale MiKTeX
# PANDOC_PDF_ENGINE=C:\Users\ivand\AppData\Local\Programs\MiKTeX\miktex\bin\x64\xelatex.exe

# Limiti
MAX_FILE_SIZE_MB=10
MAX_TEMPLATE_CONTENT_BYTES=200000
MAX_PDF_MARKDOWN_BYTES=300000

# Layout PDF (opzionali — hanno default nel service)
PDF_PAPER=a4
PDF_FONT_SIZE=11pt
PDF_MARGIN_TOP=2.5cm
PDF_MARGIN_BOTTOM=2.5cm
PDF_MARGIN_LEFT=2.5cm
PDF_MARGIN_RIGHT=2.5cm
PDF_MAIN_FONT=Liberation Serif
PDF_SANS_FONT=Liberation Sans
PDF_MONO_FONT=Liberation Mono

# GitHub template source
GITHUB_TEMPLATES_OWNER=Ivandragon003
GITHUB_TEMPLATES_REPO=generazione-documentale
GITHUB_TEMPLATES_BRANCH=main
GITHUB_TEMPLATES_DIR=templates-catalog
GITHUB_TEMPLATES_CATALOG_PATH=templates-catalog/CATALOG.json
GITHUB_TOKEN=
