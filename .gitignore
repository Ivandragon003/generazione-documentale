# ─── Build & Dependencies ───────────────────────────────
/dist
/node_modules
/coverage

# ─── Database ───────────────────────────────────────────
/db/*
!db/schema.sql

# ─── Scripts ─────────────────────────────────────────────
/scripts

# ─── Templates catalog ───────────────────────────────────
/templates-catalog

# ─── Docker ──────────────────────────────────────────────
.dockerignore
docker-compose.yml
Dockerfile

# ─── Env files ───────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Lock files ──────────────────────────────────────────
package-lock.json
pnpm-lock.yaml
yarn.lock

# ─── Documentation ───────────────────────────────────────
README.md

# ─── Logs ────────────────────────────────────────────────
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Runtime ─────────────────────────────────────────────
tmp
.temp
*.pid
*.pid.lock

# ─── OS / Editor ─────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea

# ─── Storage runtime artifacts ───────────────────────────
storage/uploads/*
