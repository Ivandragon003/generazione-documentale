# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.*.local
.env.test
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-workspace
*.sublime-project

# OS
.DS_Store
Thumbs.db
.thumb

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build/Dist
dist/
build/

# Runtime
.cache
.tmp

# Storage — file generati a runtime (non tracciare contenuto, solo cartella)
storage/uploads/*
!storage/uploads/.gitkeep
storage/pdf/*
!storage/pdf/.gitkeep
storage/templates/*
!storage/templates/.gitkeep

# Test artifacts
storage/test-runs/*.json

# ─── Database ─────────────────────────────────────────────────────────────────
# I file SQL in db/ sono SEMPRE tracciati (schema, migration, seed).
# NON aggiungere db/ o *.sql a questo file.
# Fanno eccezione solo i dump produzione (mai nel repo):
*.dump
*.pgdump
