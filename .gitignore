storage/pdf/*
!storage/pdf/.gitkeep
storage/templates/*
!storage/templates/.gitkeep
!storage/templates/CATALOG.md
storage/test-runs/*.json

# ─── Database dumps ──────────────────────────────────────
*.dump
*.pgdump

# ─── NestJS build cache ──────────────────────────────────
.tsbuildinfo
*.tsbuildinfo