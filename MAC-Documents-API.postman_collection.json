{
  "info": {
    "_postman_id": "mac-documents-api-current",
    "name": "MAC Documents API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "template_id",
      "value": "github%3Aportfolio%2Fsezione-commerciale%2Fofferta"
    },
    {
      "key": "pdf_job_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Lista template GitHub",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/templates"
      }
    },
    {
      "name": "Dettaglio template",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/templates/{{template_id}}"
      }
    },
    {
      "name": "Valida template",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"# {{titolo}}\\n\\nCliente: {{cliente:text}}\\nData: {{data:date}}\"\n}"
        },
        "url": "{{base_url}}/api/templates/validate"
      }
    },
    {
      "name": "Genera PDF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-user",
            "value": "postman"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fieldValues\": {\n    \"titolo\": \"Documento Test\",\n    \"cliente\": \"Acme SpA\",\n    \"data\": \"2026-05-13\"\n  }\n}"
        },
        "url": "{{base_url}}/api/templates/{{template_id}}/pdf"
      }
    },
    {
      "name": "Lista job PDF",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/templates/{{template_id}}/pdf/jobs"
      }
    },
    {
      "name": "Stato job PDF",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/templates/{{template_id}}/pdf/jobs/{{pdf_job_id}}"
      }
    },
    {
      "name": "Download job PDF",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/templates/{{template_id}}/pdf/jobs/{{pdf_job_id}}/download"
      }
    },
    {
      "name": "Download ultimo PDF",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/templates/{{template_id}}/pdf/latest"
      }
    }
  ]
}
