{
  "info": {
    "name": "MAC Documents API",
    "_postman_id": "mac-documents-api-v2",
    "description": "API per la generazione documentale basata su template Markdown.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "00 Internal",
      "item": [
        {
          "name": "Reset DB (dev only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-reset-confirm", "value": "true" }],
            "url": { "raw": "{{baseUrl}}/api/dev/reset", "host": ["{{baseUrl}}"], "path": ["api","dev","reset"] }
          }
        }
      ]
    },
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "02 Templates",
      "item": [
        {
          "name": "Valida Markdown (testo)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"# {{titolo}}\\n\\nCliente: {{cliente}}\\nImporto: {{importo}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/templates/validate-md", "host": ["{{baseUrl}}"], "path": ["api","templates","validate-md"] }
          }
        },
        {
          "name": "Importa template da file .md",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "name", "value": "Template da file", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/templates/upload", "host": ["{{baseUrl}}"], "path": ["api","templates","upload"] }
          }
        },
        {
          "name": "Crea template (JSON)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user", "value": "postman" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Template Contratto\",\n  \"description\": \"Contratto standard\",\n  \"content\": \"# {{titolo}}\\n\\nCliente: {{cliente}}\\nImporto: {{importo}}\\nData: {{data}}\",\n  \"fields\": [\n    { \"name\": \"titolo\",  \"label\": \"Titolo\",  \"type\": \"text\",   \"required\": true },\n    { \"name\": \"cliente\", \"label\": \"Cliente\", \"type\": \"text\",   \"required\": true },\n    { \"name\": \"importo\", \"label\": \"Importo\", \"type\": \"number\", \"required\": true },\n    { \"name\": \"data\",    \"label\": \"Data\",    \"type\": \"date\",   \"required\": true }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/templates", "host": ["{{baseUrl}}"], "path": ["api","templates"] }
          }
        },
        {
          "name": "Lista template",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates", "host": ["{{baseUrl}}"], "path": ["api","templates"] }
          }
        },
        {
          "name": "Dettaglio template",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates/:id", "host": ["{{baseUrl}}"], "path": ["api","templates",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Aggiorna template",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user", "value": "postman" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Descrizione aggiornata\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/templates/:id", "host": ["{{baseUrl}}"], "path": ["api","templates",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Elimina template",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "x-user", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/api/templates/:id", "host": ["{{baseUrl}}"], "path": ["api","templates",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Cronologia versioni template",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates/:id/versions", "host": ["{{baseUrl}}"], "path": ["api","templates",":id","versions"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Contenuto versione specifica",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates/:id/versions/:version", "host": ["{{baseUrl}}"], "path": ["api","templates",":id","versions",":version"], "variable": [{ "key": "id", "value": "" }, { "key": "version", "value": "1" }] }
          }
        },
        {
          "name": "Ripristina versione template",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-user", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/api/templates/:id/restore/:version", "host": ["{{baseUrl}}"], "path": ["api","templates",":id","restore",":version"], "variable": [{ "key": "id", "value": "" }, { "key": "version", "value": "1" }] }
          }
        },
        {
          "name": "Esporta template come .md",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates/:id/export", "host": ["{{baseUrl}}"], "path": ["api","templates",":id","export"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Audit log template",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates/:id/audit", "host": ["{{baseUrl}}"], "path": ["api","templates",":id","audit"], "variable": [{ "key": "id", "value": "" }] }
          }
        }
      ]
    },
    {
      "name": "03 Documents",
      "item": [
        {
          "name": "Crea documento da template",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user", "value": "postman" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Documento Test\",\n  \"templateId\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/documents", "host": ["{{baseUrl}}"], "path": ["api","documents"] }
          }
        },
        {
          "name": "Lista documenti",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents", "host": ["{{baseUrl}}"], "path": ["api","documents"] }
          }
        },
        {
          "name": "Dettaglio documento",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/:id", "host": ["{{baseUrl}}"], "path": ["api","documents",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Aggiorna documento (fieldValues)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user", "value": "postman" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fieldValues\": {\n    \"titolo\": \"Contratto 2026\",\n    \"cliente\": \"Mario Rossi\",\n    \"importo\": \"1000\",\n    \"data\": \"2026-05-01\"\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/api/documents/:id", "host": ["{{baseUrl}}"], "path": ["api","documents",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Elimina documento",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "x-user", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/api/documents/:id", "host": ["{{baseUrl}}"], "path": ["api","documents",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Accoda generazione PDF",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-user", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/api/documents/:id/generate-pdf", "host": ["{{baseUrl}}"], "path": ["api","documents",":id","generate-pdf"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Scarica ultimo PDF",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/:id/pdf/latest", "host": ["{{baseUrl}}"], "path": ["api","documents",":id","pdf","latest"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Anteprima PDF (temporanea)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/:id/preview-pdf", "host": ["{{baseUrl}}"], "path": ["api","documents",":id","preview-pdf"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Cronologia versioni documento",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/:id/versions", "host": ["{{baseUrl}}"], "path": ["api","documents",":id","versions"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Contenuto versione specifica documento",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/:id/versions/:version", "host": ["{{baseUrl}}"], "path": ["api","documents",":id","versions",":version"], "variable": [{ "key": "id", "value": "" }, { "key": "version", "value": "1" }] }
          }
        },
        {
          "name": "Ripristina versione documento",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-user", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/api/documents/:id/restore/:version", "host": ["{{baseUrl}}"], "path": ["api","documents",":id","restore",":version"], "variable": [{ "key": "id", "value": "" }, { "key": "version", "value": "1" }] }
          }
        },
        {
          "name": "Esporta documento come .md",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/:id/export-md", "host": ["{{baseUrl}}"], "path": ["api","documents",":id","export-md"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Audit log documento",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/:id/audit", "host": ["{{baseUrl}}"], "path": ["api","documents",":id","audit"], "variable": [{ "key": "id", "value": "" }] }
          }
        }
      ]
    }
  ]
}
