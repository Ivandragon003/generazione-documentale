    {
      "name": "02 Templates",
      "item": [
        {
          "name": "POST /api/templates/validate-md",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/templates/validate-md",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"# {{titolo}}\\n\\nQuesto paragrafo e testo normale e deve restare uguale nel documento.\\n\\n## Dati generali\\n- Committente: {{committente}}\\n- Responsabile: {{responsabile}}\\n- Data emissione: {{data}}\\n\\n## Oggetto\\n{{descrizione}}\\n\\n## Importi\\nBudget previsto: {{budget}}\\nSconto applicato: {{sconto}}\\n\\n## Note interne\\nQuesta frase non contiene campi dinamici.\\n\\nFirma: {{firma}}\"\n}"
            }
          }
        },
        {
          "name": "POST /api/templates/validate-file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-user",
                "value": "{{user}}"
              }
            ],
            "url": "{{base_url}}/api/templates/validate-file",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "C:\\Users\\ivand\\OneDrive\\Desktop\\mac-documents\\storage\\samples\\template-upload-valido.md"
                }
              ]
            }
          }
        },
        {
          "name": "POST /api/templates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user",
                "value": "{{user}}"
              }
            ],
            "url": "{{base_url}}/api/templates",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Template Capitolato Tecnico Esteso\",\n  \"description\": \"Template di test con testo fisso, liste, tabella e campi compilati solo in parte\",\n  \"content\": \"# {{titolo}}\\n\\nQuesto documento contiene testo normale che non deve cambiare quando vengono valorizzati i campi. Serve per verificare la differenza tra content e field_values.\\n\\n## 1. Dati generali\\n\\n| Campo | Valore |\\n| --- | --- |\\n| Committente | {{committente}} |\\n| Responsabile | {{responsabile}} |\\n| Data emissione | {{data}} |\\n| Codice gara | {{codice_gara}} |\\n\\n## 2. Oggetto della fornitura\\n\\n{{descrizione}}\\n\\nIl fornitore dovra garantire assistenza, documentazione tecnica e formazione iniziale. Questa riga e testo fisso.\\n\\n## 3. Requisiti\\n\\n- Ambiente cloud con backup giornaliero.\\n- Tracciamento audit delle operazioni principali.\\n- Integrazione con il sistema {{sistema_esterno}}.\\n- SLA richiesto: {{sla}}.\\n\\n## 4. Quadro economico\\n\\nBudget massimo: {{budget}}\\nSconto previsto: {{sconto}}\\nPenale giornaliera: {{penale}}\\n\\n## 5. Chiusura\\n\\nNote finali: {{note_finali}}\\n\\nFirma autorizzata: {{firma}}\",\n  \"fields\": [\n    {\n      \"name\": \"titolo\",\n      \"label\": \"titolo\",\n      \"type\": \"text\",\n      \"required\": true,\n      \"defaultValue\": \"\"\n    },\n    {\n      \"name\": \"committente\",\n      \"label\": \"committente\",\n      \"type\": \"text\",\n      \"required\": true,\n      \"defaultValue\": \"\"\n    },\n    {\n      \"name\": \"responsabile\",\n      \"label\": \"responsabile\",\n      \"type\": \"text\",\n      \"required\": false,\n      \"defaultValue\": \"Da assegnare\"\n    },\n    {\n      \"name\": \"data\",\n      \"label\": \"data\",\n      \"type\": \"date\",\n      \"required\": true,\n      \"defaultValue\": \"\"\n    },\n    {\n      \"name\": \"codice_gara\",\n      \"label\": \"codice gara\",\n      \"type\": \"text\",\n      \"required\": false,\n      \"defaultValue\": \"\"\n    },\n    {\n      \"name\": \"descrizione\",\n      \"label\": \"descrizione\",\n      \"type\": \"text\",\n      \"required\": false,\n      \"defaultValue\": \"\"\n    },\n    {\n      \"name\": \"sistema_esterno\",\n      \"label\": \"sistema esterno\",\n      \"type\": \"text\",\n      \"required\": false,\n      \"defaultValue\": \"\"\n    },\n    {\n      \"name\": \"sla\",\n      \"label\": \"sla\",\n      \"type\": \"text\",\n      \"required\": false,\n      \"defaultValue\": \"\"\n    },\n    {\n      \"name\": \"budget\",\n      \"label\": \"budget\",\n      \"type\": \"text\",\n      \"required\": true,\n      \"defaultValue\": \"\"\n    },\n    {\n      \"name\": \"sconto\",\n      \"label\": \"sconto\",\n      \"type\": \"text\",\n      \"required\": false,\n      \"defaultValue\": \"0%\"\n    },\n    {\n      \"name\": \"penale\",\n      \"label\": \"penale\",\n      \"type\": \"text\",\n      \"required\": false,\n      \"defaultValue\": \"N/A\"\n    },\n    {\n      \"name\": \"note_finali\",\n      \"label\": \"note finali\",\n      \"type\": \"text\",\n      \"required\": false,\n      \"defaultValue\": \"Nessuna nota\"\n    },\n    {\n      \"name\": \"firma\",\n      \"label\": \"firma\",\n      \"type\": \"text\",\n      \"required\": false,\n      \"defaultValue\": \"\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "PUT /api/templates/:id",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user",
                "value": "{{user}}"
              }
            ],
            "url": "{{base_url}}/api/templates/{{template_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Seconda versione temporanea per testare versioning e ripristino\",\n  \"content\": \"# {{titolo}}\\n\\nVERSIONE 2 TEMPORANEA: questa riga deve sparire dopo il ripristino.\\n\\n## Cliente\\n{{committente}}\\n\\n## Responsabile\\n{{responsabile}}\\n\\n## Data\\n{{data}}\\n\\n## Dettaglio tecnico\\n{{descrizione}}\\n\\n## Budget\\n{{budget}}\\n\\n## Approvazione\\nFirma: {{firma}}\"\n}"
            }
          }
        },
        {
          "name": "POST /api/templates/:id/restore/:version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-user",
                "value": "{{user}}"
              }
            ],
            "url": "{{base_url}}/api/templates/{{template_id}}/restore/1"
          }
