{
  "info": {
    "name": "MAC Documents API",
    "_postman_id": "mac-documents-api-v3",
    "description": "API per la generazione documentale basata su template Markdown.\n\nGli ID vengono salvati automaticamente nelle variabili di ambiente dopo ogni creazione.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "00 Internal",
      "item": [
        {
          "name": "Reset DB",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-reset-confirm", "value": "true" }],
            "url": { "raw": "{{baseUrl}}/api/dev/reset", "host": ["{{baseUrl}}"], "path": ["api","dev","reset"] }
          }
        }
      ]
    },
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "02 Templates",
      "item": [
        {
          "name": "Valida Markdown (testo)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"# {{titolo}}\\n\\nCliente: {{cliente}}\\nImporto: {{importo}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/templates/validate-md", "host": ["{{baseUrl}}"], "path": ["api","templates","validate-md"] }
          }
        },
        {
          "name": "Importa template da file .md",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "name", "value": "Template da file", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/templates/upload", "host": ["{{baseUrl}}"], "path": ["api","templates","upload"] }
          }
        },
        {
          "name": "Crea template (JSON)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.id) {",
                "  pm.environment.set('templateId', res.id);",
                "  console.log('templateId salvato:', res.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user", "value": "postman" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Template Contratto\",\n  \"description\": \"Contratto standard\",\n  \"content\": \"# {{titolo}}\\n\\nCliente: {{cliente}}\\nImporto: {{importo}}\\nData: {{data}}\",\n  \"fields\": [\n    { \"name\": \"titolo\",  \"label\": \"Titolo\",  \"type\": \"text\",   \"required\": true },\n    { \"name\": \"cliente\", \"label\": \"Cliente\", \"type\": \"text\",   \"required\": true },\n    { \"name\": \"importo\", \"label\": \"Importo\", \"type\": \"number\", \"required\": true },\n    { \"name\": \"data\",    \"label\": \"Data\",    \"type\": \"date\",   \"required\": true }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/templates", "host": ["{{baseUrl}}"], "path": ["api","templates"] }
          }
        },
        {
          "name": "Lista template",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates", "host": ["{{baseUrl}}"], "path": ["api","templates"] }
          }
        },
        {
          "name": "Dettaglio template",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates/{{templateId}}", "host": ["{{baseUrl}}"], "path": ["api","templates","{{templateId}}"] }
          }
        },
        {
          "name": "Aggiorna template",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user", "value": "postman" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Descrizione aggiornata\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/templates/{{templateId}}", "host": ["{{baseUrl}}"], "path": ["api","templates","{{templateId}}"] }
          }
        },
        {
          "name": "Elimina template",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "x-user", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/api/templates/{{templateId}}", "host": ["{{baseUrl}}"], "path": ["api","templates","{{templateId}}"] }
          }
        },
        {
          "name": "Cronologia versioni template",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates/{{templateId}}/versions", "host": ["{{baseUrl}}"], "path": ["api","templates","{{templateId}}","versions"] }
          }
        },
        {
          "name": "Contenuto versione specifica",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates/{{templateId}}/versions/1", "host": ["{{baseUrl}}"], "path": ["api","templates","{{templateId}}","versions","1"] }
          }
        },
        {
          "name": "Ripristina versione template",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-user", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/api/templates/{{templateId}}/restore/1", "host": ["{{baseUrl}}"], "path": ["api","templates","{{templateId}}","restore","1"] }
          }
        },
        {
          "name": "Esporta template come .md",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates/{{templateId}}/export", "host": ["{{baseUrl}}"], "path": ["api","templates","{{templateId}}","export"] }
          }
        },
        {
          "name": "Audit log template",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/templates/{{templateId}}/audit", "host": ["{{baseUrl}}"], "path": ["api","templates","{{templateId}}","audit"] }
          }
        }
      ]
    },
    {
      "name": "03 Documents",
      "item": [
        {
          "name": "Crea documento da template",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.id) {",
                "  pm.environment.set('documentId', res.id);",
                "  console.log('documentId salvato:', res.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user", "value": "postman" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Documento Test\",\n  \"templateId\": \"{{templateId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/documents", "host": ["{{baseUrl}}"], "path": ["api","documents"] }
          }
        },
        {
          "name": "Lista documenti",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents", "host": ["{{baseUrl}}"], "path": ["api","documents"] }
          }
        },
        {
          "name": "Dettaglio documento",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}"] }
          }
        },
        {
          "name": "Aggiorna documento (fieldValues)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user", "value": "postman" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fieldValues\": {\n    \"titolo\": \"Contratto 2026\",\n    \"cliente\": \"Mario Rossi\",\n    \"importo\": \"1000\",\n    \"data\": \"2026-05-01\"\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}"] }
          }
        },
        {
          "name": "Elimina documento",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "x-user", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}"] }
          }
        },
        {
          "name": "Accoda generazione PDF",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.jobId) {",
                "  pm.environment.set('pdfJobId', res.jobId);",
                "  console.log('pdfJobId salvato:', res.jobId);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "x-user", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}/generate-pdf", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}","generate-pdf"] }
          }
        },
        {
          "name": "Scarica ultimo PDF",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}/pdf/latest", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}","pdf","latest"] }
          }
        },
        {
          "name": "Anteprima PDF (temporanea)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}/preview-pdf", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}","preview-pdf"] }
          }
        },
        {
          "name": "Cronologia versioni documento",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}/versions", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}","versions"] }
          }
        },
        {
          "name": "Contenuto versione specifica documento",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}/versions/1", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}","versions","1"] }
          }
        },
        {
          "name": "Ripristina versione documento",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-user", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}/restore/1", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}","restore","1"] }
          }
        },
        {
          "name": "Esporta documento come .md",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}/export-md", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}","export-md"] }
          }
        },
        {
          "name": "Audit log documento",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}/audit", "host": ["{{baseUrl}}"], "path": ["api","documents","{{documentId}}","audit"] }
          }
        }
      ]
    },
    {
      "name": "04 PDF",
      "item": [
        {
          "name": "Valida template per PDF",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/pdf/templates/{{templateId}}/validate", "host": ["{{baseUrl}}"], "path": ["api","pdf","templates","{{templateId}}","validate"] }
          }
        }
      ]
    }
  ]
}
