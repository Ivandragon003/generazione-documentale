# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database PostgreSQL ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mac_documents

# ─── Storage ──────────────────────────────────────────────────────────────────
# Cartella dove vengono salvati i PDF generati
STORAGE_PATH=./storage/pdf

# Cartella dove vengono salvati i template .md (file-system, non DB)
TEMPLATE_STORAGE_PATH=./storage/templates

# Cartella temporanea per upload multipart
UPLOAD_PATH=./storage/uploads

# Dimensione massima upload file .md
MAX_FILE_SIZE_MB=10

# ─── Pandoc ───────────────────────────────────────────────────────────────────
# Windows (WinGet): PANDOC_PATH=C:\Users\<utente>\AppData\Local\Microsoft\WinGet\Packages\JohnMacFarlane.Pandoc_Microsoft.Winget.Source_8wekyb3d8bbwe\pandoc-3.9.0.2\pandoc.exe
# Windows (installazione standard): PANDOC_PATH=C:\Program Files\Pandoc\pandoc.exe
# Linux/macOS: PANDOC_PATH=pandoc
PANDOC_PATH=pandoc

# Windows con MiKTeX: PANDOC_PDF_ENGINE=C:\Users\<utente>\AppData\Local\Programs\MiKTeX\miktex\bin\x64\pdflatex.exe
# Linux/macOS con TeX Live: PANDOC_PDF_ENGINE=pdflatex
PANDOC_PDF_ENGINE=pdflatex

# ─── Generazione PDF ──────────────────────────────────────────────────────────
# Tentativi in caso di errore Pandoc
PDF_GENERATION_RETRIES=2

# Delay tra un tentativo e il successivo (ms)
PDF_GENERATION_RETRY_DELAY_MS=500

# Timeout massimo per singola generazione PDF (ms)
PDF_GENERATION_TIMEOUT_MS=60000

# Dimensione massima Markdown inviato a Pandoc (bytes)
MAX_PDF_MARKDOWN_BYTES=300000

# Dimensione massima contenuto template (bytes)
MAX_TEMPLATE_CONTENT_BYTES=200000

# ─── Worker PDF asincrono ─────────────────────────────────────────────────────
# Numero di job PDF eseguiti in parallelo
PDF_JOB_CONCURRENCY=1

# ─── Ambiente ─────────────────────────────────────────────────────────────────
# 'development' abilita le route /api/dev/* (reset DB, test runner)
# 'production'  le blocca completamente
NODE_ENV=development
