NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mac_documents

# GitHub storage for Markdown templates
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=tuo-username
GITHUB_REPO=mac-documents-templates
GITHUB_BRANCH=main
GITHUB_TEMPLATES_DIR=templates

# Limits
MAX_TEMPLATE_CONTENT_BYTES=200000
MAX_PDF_MARKDOWN_BYTES=300000

# PDF service / local Pandoc fallback
PDF_SERVICE_URL=
PANDOC_PATH=pandoc
PDF_ENGINE=xelatex

# PDF generation
PDF_GENERATION_RETRIES=2
PDF_GENERATION_RETRY_DELAY_MS=1000
PDF_GENERATION_TIMEOUT_MS=120000
PDF_QUEUE_RECOVERY_RETRY_MS=10000

# PDF layout
PDF_PAPER=a4
PDF_FONT_SIZE=11pt
PDF_MARGIN_TOP=2.5cm
PDF_MARGIN_BOTTOM=2.5cm
PDF_MARGIN_LEFT=2.5cm
PDF_MARGIN_RIGHT=2.5cm
PDF_MAIN_FONT=Liberation Serif
PDF_SANS_FONT=Liberation Sans
PDF_MONO_FONT=Liberation Mono

# Misc
RUN_REGRESSION_ON_BOOT=false
