NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mac_documents

# GitHub storage for Markdown templates
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=tuo-username
GITHUB_REPO=mac-documents-templates
GITHUB_BRANCH=main
# Leave empty to use tenant folders at repository root:
# {tenantUuid}/path/template.md
GITHUB_TEMPLATES_DIR=

# Limits
MAX_TEMPLATE_CONTENT_BYTES=200000
MAX_PDF_MARKDOWN_BYTES=300000

# PDF service / local Pandoc fallback
PDF_SERVICE_URL=
ENABLE_LOCAL_PDF_FALLBACK=true
PANDOC_PATH=pandoc
PDF_ENGINE=xelatex

# PDF generation
PDF_GENERATION_RETRIES=2
PDF_GENERATION_RETRY_DELAY_MS=1000
PDF_GENERATION_TIMEOUT_MS=120000
PDF_QUEUE_RECOVERY_RETRY_MS=10000
# Audit logs older than this are deleted by scheduled backend retention.
# Set 0 or a negative value to disable audit retention.
AUDIT_LOG_RETENTION_DAYS=180
PDF_SERVICE_DEBUG=false
PDF_SERVICE_SAVE_TEX_ON_ERROR=false

# AI semantic audit (experimental)
AI_PROVIDER=mock
# If backend runs in Docker and Ollama runs on host, use host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_DRAFT_NUM_PREDICT=1200
OLLAMA_AUDIT_NUM_PREDICT=350
OLLAMA_COMPACT_PROMPT_CHARS=14000
OLLAMA_MAX_PROMPT_CHARS=20000
OLLAMA_DRAFT_TEMPERATURE=0.2
OLLAMA_AUDIT_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=10m
AI_AUDIT_DEBUG=false
AI_AUDIT_MIN_CONFIDENCE=0.60
AI_AUDIT_CACHE_TTL_MS=300000

# PDF layout
PDF_PAPER=a4
PDF_FONT_SIZE=11pt
PDF_MARGIN_TOP=2.5cm
PDF_MARGIN_BOTTOM=2.5cm
PDF_MARGIN_LEFT=2.5cm
PDF_MARGIN_RIGHT=2.5cm
PDF_MAIN_FONT=DejaVu Sans
PDF_SANS_FONT=DejaVu Sans
PDF_MONO_FONT=DejaVu Sans Mono
PDF_CJK_MAIN_FONT=Noto Sans CJK JP

# CORS (comma-separated origins; defaults to localhost dev ports)
# CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:3001

# Misc

# Deprecated / currently unused (kept only for backward compatibility)
# These keys are not read by the current backend runtime:
# UPLOAD_PATH=./storage/uploads
# TEMPLATES_STORAGE_PATH=./storage/templates
# MAX_FILE_SIZE_MB=10

