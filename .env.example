NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mac_documents

# ─── GitHub Storage (template Markdown) ───────────────────────────────────────
# Personal Access Token con scope "repo" (classic) oppure "contents:write" (fine-grained)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Owner del repository (utente GitHub o organizzazione)
GITHUB_OWNER=tuo-username
# Nome del repository che conterrà i template
GITHUB_REPO=mac-documents-templates
# Branch di destinazione (default: main)
GITHUB_BRANCH=main
# Directory nel repo dove salvare i file .md (default: templates)
GITHUB_TEMPLATES_DIR=templates

# ─── Storage locale (usato solo per upload temporanei) ────────────────────────
UPLOAD_PATH=./storage/uploads

# ─── Limiti ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_TEMPLATE_CONTENT_BYTES=200000
MAX_PDF_MARKDOWN_BYTES=300000

# ─── Pandoc / XeLaTeX ─────────────────────────────────────────────────────────
PANDOC_PATH=pandoc
PDF_ENGINE=xelatex

# ─── Generazione PDF ──────────────────────────────────────────────────────────
PDF_GENERATION_RETRIES=2
PDF_GENERATION_RETRY_DELAY_MS=1000
PDF_GENERATION_TIMEOUT_MS=120000
PDF_QUEUE_RECOVERY_RETRY_MS=10000

# ─── Layout PDF ───────────────────────────────────────────────────────────────
PDF_PAPER=a4
PDF_FONT_SIZE=11pt
PDF_MARGIN_TOP=2.5cm
PDF_MARGIN_BOTTOM=2.5cm
PDF_MARGIN_LEFT=2.5cm
PDF_MARGIN_RIGHT=2.5cm
PDF_MAIN_FONT=Liberation Serif
PDF_SANS_FONT=Liberation Sans
PDF_MONO_FONT=Liberation Mono

# ─── Misc ─────────────────────────────────────────────────────────────────────
RUN_REGRESSION_ON_BOOT=false
