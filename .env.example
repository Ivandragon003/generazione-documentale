NODE_ENV=development
PORT=3000

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PATH=./storage/pdf
UPLOAD_PATH=./storage/uploads
TEMPLATES_STORAGE_PATH=./storage/templates

# ─── Limiti ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_TEMPLATE_CONTENT_BYTES=200000
MAX_PDF_MARKDOWN_BYTES=300000

# ─── Pandoc / XeLaTeX ─────────────────────────────────────────────────────────
# Installazione locale necessaria se non si usa Docker:
#   Linux: sudo apt install pandoc texlive-xetex texlive-fonts-recommended
#   Mac:   brew install pandoc && brew install --cask mactex
PANDOC_PATH=pandoc
PDF_ENGINE=xelatex

# ─── Generazione PDF ──────────────────────────────────────────────────────────
PDF_GENERATION_RETRIES=2
PDF_GENERATION_RETRY_DELAY_MS=1000
PDF_GENERATION_TIMEOUT_MS=120000
PDF_QUEUE_RECOVERY_RETRY_MS=10000

# ─── Layout PDF ───────────────────────────────────────────────────────────────
PDF_PAPER=a4
PDF_FONT_SIZE=11pt
PDF_MARGIN_TOP=2.5cm
PDF_MARGIN_BOTTOM=2.5cm
PDF_MARGIN_LEFT=2.5cm
PDF_MARGIN_RIGHT=2.5cm
PDF_MAIN_FONT=Liberation Serif
PDF_SANS_FONT=Liberation Sans
PDF_MONO_FONT=Liberation Mono

# ─── Misc ─────────────────────────────────────────────────────────────────────
RUN_REGRESSION_ON_BOOT=false