{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Applicazione attiva",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Health check applicazione",
        "tags": ["health"]
      }
    },
    "/api/templates": {
      "get": {
        "operationId": "TemplatesController_findAll",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "example": 0,
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": ["draft", "published"],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Lista template",
        "tags": ["templates"]
      },
      "post": {
        "operationId": "TemplatesController_create",
        "parameters": [
          {
            "name": "x-user",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "ivan"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTemplateDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Crea template",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}": {
      "get": {
        "operationId": "TemplatesController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID template",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Template non trovato"
          }
        },
        "summary": "Dettaglio template",
        "tags": ["templates"]
      },
      "put": {
        "operationId": "TemplatesController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID template",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "ivan"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTemplateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Aggiorna template",
        "tags": ["templates"]
      },
      "delete": {
        "operationId": "TemplatesController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID template",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "ivan"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Elimina template",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/export": {
      "get": {
        "operationId": "TemplatesController_export",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID template",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Esporta template come file .md",
        "tags": ["templates"]
      }
    },
    "/api/templates/import": {
      "post": {
        "operationId": "TemplatesController_import",
        "parameters": [
          {
            "name": "x-user",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "ivan"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImportTemplateFileDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Importa template da file .md",
        "tags": ["templates"]
      }
    },
    "/api/templates/validate": {
      "post": {
        "operationId": "TemplatesController_validate",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateMarkdownDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Valida contenuto Markdown",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/pdf": {
      "post": {
        "operationId": "TemplatesController_generatePdf",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID template",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "ivan"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeneratePdfDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Avvia generazione PDF da template",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/pdf/jobs": {
      "get": {
        "operationId": "TemplatesController_getPdfJobs",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID template",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Lista job PDF del template",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/pdf/jobs/{jobId}": {
      "get": {
        "operationId": "TemplatesController_getPdfJob",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID template",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobId",
            "required": true,
            "in": "path",
            "description": "UUID job",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Dettaglio job PDF",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/pdf/jobs/{jobId}/download": {
      "get": {
        "operationId": "TemplatesController_downloadPdfJob",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID template",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobId",
            "required": true,
            "in": "path",
            "description": "UUID job",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Scarica PDF da job specifico",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/pdf/latest": {
      "get": {
        "operationId": "TemplatesController_downloadLatestPdf",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID template",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Scarica l'ultimo PDF completato",
        "tags": ["templates"]
      }
    }
  },
  "info": {
    "title": "MAC Documents API",
    "description": "API per la generazione documentale basata su template Markdown.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Stato applicazione"
    },
    {
      "name": "templates",
      "description": "Gestione template documentali"
    },
    {
      "name": "documents",
      "description": "Gestione documenti generati"
    },
    {
      "name": "pdf",
      "description": "Utilita generazione PDF"
    },
    {
      "name": "dev",
      "description": "Utility ambiente locale"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "TemplateFieldDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "titolo"
          },
          "label": {
            "type": "string",
            "example": "Titolo"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "date",
              "boolean",
              "email",
              "url",
              "tel",
              "select",
              "currency"
            ],
            "example": "text",
            "description": "Tipo del campo. 'select': opzioni in defaultValue separate da virgola."
          },
          "required": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "defaultValue": {
            "type": "string",
            "example": "",
            "description": "Valore di default. Per type=select: lista opzioni separate da virgola (es. \"Attivo,In attesa,Chiuso\")."
          }
        },
        "required": ["name"]
      },
      "CreateTemplateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome del template",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "description": "Descrizione del template"
          },
          "content": {
            "type": "string",
            "description": "Contenuto Markdown del template"
          },
          "fields": {
            "description": "Definizioni dei campi",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldDto"
            }
          },
          "status": {
            "type": "string",
            "description": "Stato del template",
            "enum": ["draft", "published"],
            "default": "draft"
          },
          "path": {
            "type": "string",
            "description": "Percorso GitHub opzionale per sovrascrittura"
          }
        },
        "required": ["name", "content"]
      },
      "UpdateTemplateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome del template",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "description": "Descrizione del template"
          },
          "content": {
            "type": "string",
            "description": "Contenuto Markdown del template"
          },
          "fields": {
            "description": "Definizioni dei campi",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldDto"
            }
          },
          "status": {
            "type": "string",
            "description": "Stato del template",
            "enum": ["draft", "published"],
            "default": "draft"
          },
          "path": {
            "type": "string",
            "description": "Percorso GitHub opzionale per sovrascrittura"
          }
        }
      },
      "ImportTemplateFileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome del template (opzionale)",
            "example": "Template importato"
          }
        }
      },
      "ValidateMarkdownDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "example": "# {{titolo}}\n\nCliente: {{cliente}}"
          }
        },
        "required": ["content"]
      },
      "GeneratePdfDto": {
        "type": "object",
        "properties": {
          "fieldValues": {
            "type": "object",
            "description": "Valori dei campi per la sostituzione dei placeholder",
            "example": {
              "nome_cliente": "Acme SpA",
              "importo": "5000"
            }
          }
        }
      }
    }
  }
}
