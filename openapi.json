{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Applicazione attiva",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Health check applicazione",
        "tags": ["health"]
      }
    },
    "/health/pdf": {
      "get": {
        "operationId": "HealthController_checkPdf",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Health check servizio PDF/Pandoc",
        "tags": ["health"]
      }
    },
    "/api/templates": {
      "get": {
        "operationId": "TemplatesController_findAll",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "example": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "List templates",
        "tags": ["templates"]
      },
      "post": {
        "operationId": "TemplatesController_create",
        "parameters": [
          {
            "name": "x-user",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "ivan"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTemplateDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Create template",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}": {
      "get": {
        "operationId": "TemplatesController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Template UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Template not found"
          }
        },
        "summary": "Template details",
        "tags": ["templates"]
      },
      "put": {
        "operationId": "TemplatesController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Template UUID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "ivan"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTemplateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Update template",
        "tags": ["templates"]
      },
      "delete": {
        "operationId": "TemplatesController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Template UUID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "ivan"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Delete template",
        "tags": ["templates"]
      }
    },
    "/api/templates/validate": {
      "post": {
        "operationId": "TemplatesController_validateTemplate",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Validate template markdown syntax and placeholders",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/pdf": {
      "post": {
        "operationId": "TemplatesController_generatePdf",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Template UUID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "ivan"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeneratePdfDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Start PDF generation from template",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/docx": {
      "post": {
        "operationId": "TemplatesController_generateDocx",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Template UUID or github:<path>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeneratePdfDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Generate DOCX from template and download it",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/pdf/jobs": {
      "get": {
        "operationId": "TemplatesController_getPdfJobs",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Template UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "List template PDF jobs",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/pdf/jobs/{jobId}": {
      "get": {
        "operationId": "TemplatesController_getPdfJob",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Template UUID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobId",
            "required": true,
            "in": "path",
            "description": "Job UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "PDF job details",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/pdf/jobs/{jobId}/download": {
      "get": {
        "operationId": "TemplatesController_downloadPdfJob",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Template UUID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobId",
            "required": true,
            "in": "path",
            "description": "Job UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Download PDF from specific job",
        "tags": ["templates"]
      }
    },
    "/api/templates/{id}/pdf/latest": {
      "get": {
        "operationId": "TemplatesController_downloadLatestPdf",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Template UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Download latest completed PDF",
        "tags": ["templates"]
      }
    }
  },
  "info": {
    "title": "MAC Documents API",
    "description": "API for document generation based on Markdown templates.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Application health"
    },
    {
      "name": "templates",
      "description": "GitHub templates, field rendering, and PDF"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "TemplateFieldOptionDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "example": "Attivo"
          },
          "value": {
            "type": "string",
            "example": "active"
          }
        },
        "required": ["label", "value"]
      },
      "TemplateFieldColumnDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "descrizione"
          },
          "label": {
            "type": "string",
            "example": "Descrizione"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "text",
              "number",
              "integer",
              "date",
              "currency",
              "percentage",
              "boolean",
              "email",
              "phone",
              "textarea",
              "checkbox",
              "url",
              "tel",
              "select",
              "table",
              "subtable",
              "list",
              "repeater"
            ],
            "example": "text"
          },
          "required": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "defaultValue": {
            "type": "string",
            "example": ""
          },
          "placeholder": {
            "type": "string",
            "example": "Inserisci valore"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldOptionDto"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldColumnDto"
            }
          }
        },
        "required": ["name"]
      },
      "TemplateFieldDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "descrizione"
          },
          "label": {
            "type": "string",
            "example": "Descrizione"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "text",
              "number",
              "integer",
              "date",
              "currency",
              "percentage",
              "boolean",
              "email",
              "phone",
              "textarea",
              "checkbox",
              "url",
              "tel",
              "select",
              "table",
              "subtable",
              "list",
              "repeater"
            ],
            "example": "text"
          },
          "required": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "defaultValue": {
            "type": "string",
            "example": ""
          },
          "placeholder": {
            "type": "string",
            "example": "Inserisci valore"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldOptionDto"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldColumnDto"
            }
          }
        },
        "required": ["name"]
      },
      "CreateTemplateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Template name",
            "maxLength": 255
          },
          "content": {
            "type": "string",
            "description": "Template Markdown content"
          },
          "fields": {
            "description": "Definizioni dei campi",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldDto"
            }
          },
          "path": {
            "type": "string",
            "description": "Percorso GitHub opzionale per sovrascrittura"
          }
        },
        "required": ["name", "content"]
      },
      "UpdateTemplateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Template name",
            "maxLength": 255
          },
          "content": {
            "type": "string",
            "description": "Template Markdown content"
          },
          "fields": {
            "description": "Definizioni dei campi",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldDto"
            }
          },
          "path": {
            "type": "string",
            "description": "Percorso GitHub opzionale per sovrascrittura"
          }
        }
      },
      "GeneratePdfDto": {
        "type": "object",
        "properties": {
          "fieldValues": {
            "type": "object",
            "description": "Valori dei campi per la sostituzione dei placeholder",
            "example": {
              "nome_cliente": "Acme SpA",
              "importo": 5000,
              "righe": [
                {
                  "descrizione": "Servizio",
                  "quantita": 2,
                  "prezzo": 100
                }
              ]
            }
          }
        }
      }
    }
  }
}
