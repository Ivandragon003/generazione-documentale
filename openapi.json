          "content": {
            "application/json": {
              "schema": {
                "title": "CreateDocumentDto",
                "required": [
                  "name",
                  "templateId"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Capitolato Beta"
                  },
                  "templateId": {
                    "type": "string",
                    "format": "uuid",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
