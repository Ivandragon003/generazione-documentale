  "info": {
    "title": "MAC Documents API",
    "description": "API for document generation based on Markdown templates.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Application health"
    },
    {
      "name": "templates",
      "description": "GitHub templates, field rendering, and PDF"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "TemplateFieldOptionDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "example": "Active"
          },
          "value": {
            "type": "string",
            "example": "active"
          }
        },
        "required": ["label", "value"]
      },
      "TemplateFieldColumnDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "description"
          },
          "label": {
            "type": "string",
            "example": "Description"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "text",
              "date",
              "currency",
              "integer",
              "boolean",
              "percentage",
              "list",
              "number",
              "email",
              "phone",
              "textarea",
              "checkbox",
              "url",
              "tel",
              "select",
              "table",
              "subtable",
              "list",
              "repeater"
            ],
            "example": "text"
          },
          "required": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "maxLength": {
            "type": "number",
            "example": 100
          },
          "defaultValue": {
            "type": "string",
            "example": ""
          },
          "placeholder": {
            "type": "string",
            "example": "Enter value"
          },
          "listName": {
            "type": "string",
            "example": "contract_types"
          },
          "listLabel": {
            "type": "string",
            "example": "Contract type"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldOptionDto"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldColumnDto"
            }
          }
        },
        "required": ["name"]
      },
      "TemplateFieldDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "description"
          },
          "label": {
            "type": "string",
            "example": "Description"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "text",
              "date",
              "currency",
              "integer",
              "boolean",
              "percentage",
              "list",
              "number",
              "email",
              "phone",
              "textarea",
              "checkbox",
              "url",
              "tel",
              "select",
              "table",
              "subtable",
              "list",
              "repeater"
            ],
            "example": "text"
          },
          "required": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "maxLength": {
            "type": "number",
            "example": 100
          },
          "defaultValue": {
            "type": "string",
            "example": ""
          },
          "placeholder": {
            "type": "string",
            "example": "Enter value"
          },
          "listName": {
            "type": "string",
            "example": "contract_types"
          },
          "listLabel": {
            "type": "string",
            "example": "Contract type"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldOptionDto"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldColumnDto"
            }
          }
        },
        "required": ["name"]
      },
      "CreateTemplateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Template name",
            "maxLength": 255
          },
          "content": {
            "type": "string",
            "description": "Template Markdown content"
          },
          "fields": {
            "description": "Field definitions",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldDto"
            }
          },
          "path": {
            "type": "string",
            "description": "Optional GitHub path override"
          },
          "tenantUuid": {
            "type": "string",
            "description": "Tenant UUID",
            "example": "11111111-1111-1111-1111-111111111111"
          }
        },
        "required": ["name", "content"]
      },
      "UpdateTemplateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Template name",
            "maxLength": 255
          },
          "content": {
            "type": "string",
            "description": "Template Markdown content"
          },
          "fields": {
            "description": "Field definitions",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldDto"
            }
          },
          "tenantUuid": {
            "type": "string",
            "description": "Tenant UUID",
            "example": "11111111-1111-1111-1111-111111111111"
          }
        }
      },
      "GenerateTemplateDraftDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Natural language description of the document template",
            "example": "Contratto di fornitura con dati cliente, data stipula, importo e durata",
            "maxLength": 4000
          },
          "language": {
            "type": "string",
            "description": "Preferred output language for labels and sections",
            "example": "it",
            "maxLength": 16
          },
          "runSemanticAudit": {
            "type": "boolean",
            "description": "Run semantic AI audit after deterministic validation of the draft",
            "default": false
          },
          "generationMode": {
            "type": "string",
            "description": "Prompt mode: free excludes parser grammar, guided includes parser grammar",
            "enum": ["free", "guided"],
            "default": "guided"
          },
          "autoRepair": {
            "type": "boolean",
            "description": "Enable deterministic auto-repair for safe syntax fixes",
            "default": false
          },
          "defaultLength": {
            "type": "number",
            "description": "Fallback length used by auto-repair when length is invalid",
            "default": 120
          }
        },
        "required": ["description"]
      },
      "Function": {
        "type": "object",
        "properties": {}
      },
      "GeneratePdfDto": {
        "type": "object",
        "properties": {
          "fieldValues": {
            "type": "object",
            "description": "Field values used for placeholder substitution",
            "example": {
              "customer_name": "Acme Inc",
              "amount": 5000,
              "rows": [
                {
                  "description": "Service",
                  "quantity": 2,
                  "price": 100
                }
              ]
            }
          },
          "language": {
            "type": "string",
            "description": "Browser language used to choose the document script/font profile",
            "example": "en-US"
          }
        }
      }
    }
  }
}
