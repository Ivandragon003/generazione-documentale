{
  "name": "mac-documents",
  "version": "1.0.0",
  "description": "MAC Documents - Modulo documentale per Management as Code",
  "main": "src/main.js",
  "scripts": {
    "start":         "node src/main.js",
    "start:dev":     "nodemon --ignore openapi.json src/main.js",
    "migrate":       "node db/migrations/run.js",
    "seed":          "node db/scripts/seed.js",
    "seed:fixtures": "node db/scripts/seed.js --fixtures",
    "check:pandoc":  "node db/scripts/check-pandoc.js",
    "test:api":      "node db/scripts/run-api-tests.js"
  },
  "dependencies": {
    "@nestjs/common":           "^10.3.0",
    "@nestjs/core":             "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger":          "^7.3.0",
    "axios":                    "^1.7.2",
    "dotenv":                   "^16.4.5",
    "express":                  "^4.19.2",
    "multer":                   "^1.4.5-lts.1",
    "pg":                       "^8.12.0",
    "reflect-metadata":         "^0.2.0",
    "rxjs":                     "^7.8.1",
    "uuid":                     "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
