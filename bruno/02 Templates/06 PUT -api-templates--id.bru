meta {
  name: PUT /api/templates/:id
  type: http
  seq: 6
}

put {
  url: {{base_url}}/api/templates/{{template_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-user: {{user}}
}

body:json {
  {
    "description": "Seconda versione temporanea per testare versioning e ripristino",
    "content": "# {{titolo}}\n\nVERSIONE 2 TEMPORANEA: questa riga deve sparire dopo il ripristino.\n\n## Cliente\n{{committente}}\n\n## Responsabile\n{{responsabile}}\n\n## Data\n{{data}}\n\n## Dettaglio tecnico\n{{descrizione}}\n\n## Budget\n{{budget}}\n\n## Approvazione\nFirma: {{firma}}"
  }
}
